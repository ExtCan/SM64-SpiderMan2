+        { "sm64_geo_asm_stub", (const void *)sm64_geo_asm_stub },
+        { "sm64_geo_switch_stub", (const void *)sm64_geo_switch_stub },
+    };
+    if( !name ) return NULL;
+    for( size_t i = 0; i < sizeof( table ) / sizeof( table[0] ); ++i )
+        if( strcmp( table[i].name, name ) == 0 )
+            return table[i].fn;
+    return NULL;
+}
+
+SM64_LIB_FN void sm64_set_player_palette( const uint8_t rgb[8][3] )
+{
+    if( rgb ) sm64_set_player_palette_internal( rgb );
+}
