+/*
+ * Mario Mode: F3DEX2 display lists of custom models (as the PC ports and
+ * DynOS lay them out: two pointer-sized words per command, pointers in w1).
+ * Only what decides a triangle's shape and look is interpreted: vertices,
+ * triangles, lights, the texture and its tile, the colour combiner, the render
+ * mode and the colours, and sub display lists.
+ */
+
+enum
+{
+    F3D_VTX = 0x01, F3D_TRI1 = 0x05, F3D_TRI2 = 0x06, F3D_QUAD = 0x07,
+    F3D_VTX_EXT = 0x11, F3D_TRI2_EXT = 0x12,
+    F3D_SETENVRGB = 0xD1, F3D_COPYMEM = 0xD2, F3D_PPARTTOCOLOR = 0xD3,
+    F3D_TEXTURE = 0xD7, F3D_GEOMETRYMODE = 0xD9, F3D_MOVEWORD = 0xDB, F3D_MOVEMEM = 0xDC,
+    F3D_DL = 0xDE, F3D_ENDDL = 0xDF, F3D_SETOTHERMODE_L = 0xE2, F3D_SETOTHERMODE_H = 0xE3,
+    F3D_SETTILESIZE = 0xF2, F3D_LOADBLOCK = 0xF3, F3D_LOADTILE = 0xF4, F3D_SETTILE = 0xF5,
+    F3D_SETPRIMCOLOR = 0xFA, F3D_SETENVCOLOR = 0xFB, F3D_SETCOMBINE = 0xFC, F3D_SETTIMG = 0xFD,
+};
+
+#define F3D_GM_PACKED_NORMALS 0x00000080u
+#define F3D_GM_LIGHTING       0x00020000u
+#define F3D_GM_TEXTURE_GEN    0x00040000u
+#define F3D_MV_LIGHT          0x0A
+#define F3D_MW_LIGHTCOL       0x0A
+#define F3D_RM_CVG_X_ALPHA    0x1000u
+#define F3D_RM_FORCE_BL       0x4000u
+#define F3D_MAX_VERTICES      64
+#define F3D_MAX_LIGHTS        32
+
+struct F3DVertex
+{
+    float pos[3];
+    float nrm[3];
+    float col[3]; // shade
+    float alpha;
+    float uv[2];
+    int hasNormal;
+};
+
+static struct
+{
+    uint32_t geometryMode;
+    uint32_t combine0, combine1;
+    uint32_t otherModeL, otherModeH;
+    uint8_t env[4], prim[4];
+    uint8_t lights[F3D_MAX_LIGHTS][3];
+    const struct SM64CustomTexture *image; // G_SETTIMG
+    const struct SM64CustomTexture *tile;  // loaded into texture memory
+    uint16_t scaleS, scaleT;
+    int textureOn;
+    uint16_t uls, ult;
+    uint8_t cms, cmt, masks, maskt;
+    struct F3DVertex vtx[F3D_MAX_VERTICES];
+} s_f3d;
+
+static uint8_t s_palette[8][3] = {
+    { 0x00, 0x00, 0xff }, { 0xff, 0x00, 0x00 }, { 0xff, 0xff, 0xff }, { 0x72, 0x1c, 0x0e },
+    { 0x73, 0x06, 0x00 }, { 0xfe, 0xc1, 0x79 }, { 0xff, 0x00, 0x00 }, { 0xff, 0x00, 0x00 },
+};
+
+void sm64_set_player_palette_internal( const uint8_t rgb[8][3] )
+{
+    memcpy( s_palette, rgb, sizeof( s_palette ));
+}
+
+void gfx_adapter_set_custom_display_lists( const void *begin, const void *end )
+{
+    s_customBegin = (const uint8_t *)begin;
+    s_customEnd = (const uint8_t *)end;
+}
+
+static void f3d_reset( void )
+{
+    memset( &s_f3d, 0, sizeof( s_f3d ));
+    s_f3d.geometryMode = F3D_GM_LIGHTING;
+    s_f3d.env[0] = s_f3d.env[1] = s_f3d.env[2] = s_f3d.env[3] = 255;
+    s_f3d.prim[0] = s_f3d.prim[1] = s_f3d.prim[2] = s_f3d.prim[3] = 255;
+    for( int i = 0; i < 2; ++i )
+        s_f3d.lights[i][0] = s_f3d.lights[i][1] = s_f3d.lights[i][2] = 0xFF;
+    // The player part colours where coop's geo_mario_set_player_colors puts
+    // them: part p's light at index 2p+2 (its shade at 2p+3).
+    for( int p = 0; p < 8; ++p )
+    {
+        memcpy( s_f3d.lights[2 * p + 2], s_palette[p], 3 );
+        for( int k = 0; k < 3; ++k ) s_f3d.lights[2 * p + 3][k] = s_palette[p][k] / 2;
+    }
+    s_f3d.scaleS = s_f3d.scaleT = 0xFFFF;
+}
+
+static float clamp01( float v ) { return v < 0.0f ? 0.0f : v > 1.0f ? 1.0f : v; }
+
+static void f3d_load_vertices( const struct SM64CustomVertex *v, int n, int dest )
+{
+    if( !v || n <= 0 ) return;
+    for( int i = 0; i < n; ++i )
+    {
+        if( dest + i < 0 || dest + i >= F3D_MAX_VERTICES ) break;
+        struct F3DVertex *d = &s_f3d.vtx[dest + i];
+        const struct SM64CustomVertex *s = &v[i];
+        Vec3f p = { s->pos[0], s->pos[1], s->pos[2] };
+        mtxf_mul_vec3f_x( s_curMatrix, p, 1.0f, d->pos );
+
+        int lit = (s_f3d.geometryMode & F3D_GM_LIGHTING) != 0;
+        float nx = 0, ny = 0, nz = 0;
+        d->hasNormal = 0;
+        if( lit )
+        {
+            if( s_f3d.geometryMode & F3D_GM_PACKED_NORMALS )
+            {
+                // coop: the normal is packed into `flag`, cn is a colour
+                int xo = s->flag >> 8, yo = s->flag & 0xFF;
+                int x = xo & 0x7F, y = yo & 0x7F, z = ((x + y) ^ 0x7F) & 0xFF;
+                if( z & 0x80 ) { x ^= 0x7F; y ^= 0x7F; z = (x + y) ^ 0x7F; }
+                nx = (float)((xo & 0x80) ? -x : x);
+                ny = (float)((yo & 0x80) ? -y : y);
+                nz = (float)(int8_t)z;
+            }
+            else
+            {
+                nx = (float)(int8_t)s->cn[0];
+                ny = (float)(int8_t)s->cn[1];
+                nz = (float)(int8_t)s->cn[2];
+            }
+            Vec3f n = { nx / 127.0f, ny / 127.0f, nz / 127.0f };
+            if( n[0] != 0.0f || n[1] != 0.0f || n[2] != 0.0f )
+            {
+                mtxf_mul_vec3f_x( s_curMatrix, n, 0.0f, d->nrm );
+                vec3f_normalize( d->nrm );
+                d->hasNormal = 1;
+            }
+            // The material colour: the first directional light (the game
+            // lights Mario itself).
+            for( int k = 0; k < 3; ++k )
+            {
+                float c = s_f3d.lights[0][k] / 255.0f;
+                if( s_f3d.geometryMode & F3D_GM_PACKED_NORMALS ) c *= s->cn[k] / 255.0f;
+                d->col[k] = c;
+            }
+        }
+        else
+        {
+            for( int k = 0; k < 3; ++k ) d->col[k] = s->cn[k] / 255.0f;
+        }
+        d->alpha = s->cn[3] / 255.0f;
+
+        if( lit && (s_f3d.geometryMode & F3D_GM_TEXTURE_GEN) && d->hasNormal )
+        {
+            // Environment mapping: no camera here, so map by the normal.
+            d->uv[0] = 0.5f + 0.5f * d->nrm[0];
+            d->uv[1] = 0.5f - 0.5f * d->nrm[1];
+        }
+        else
+        {
+            const struct SM64CustomTexture *t = s_f3d.tile;
+            float w = t && t->width ? (float)t->width : 32.0f;
+            float h = t && t->height ? (float)t->height : 32.0f;
+            float u = (float)((int32_t)s->st[0] * s_f3d.scaleS >> 16) / 32.0f - s_f3d.uls / 4.0f;
+            float vv = (float)((int32_t)s->st[1] * s_f3d.scaleT >> 16) / 32.0f - s_f3d.ult / 4.0f;
+            d->uv[0] = u / w;
+            d->uv[1] = vv / h;
+        }
+    }
+}
+
+// Colour combiner inputs, as far as Mario's look goes.
+enum { CC_ZERO, CC_ONE, CC_TEX, CC_TEXA, CC_SHADE, CC_PRIM, CC_ENV, CC_PRIMA, CC_ENVA, CC_SHADEA, CC_COMBINED, CC_OTHER };
+
+static int cc_rgb_a( int v ) { static const int m[16] = { CC_COMBINED, CC_TEX, CC_TEX, CC_PRIM, CC_SHADE, CC_ENV, CC_ONE, CC_OTHER }; return v < 8 ? m[v] : CC_ZERO; }
+static int cc_rgb_b( int v ) { static const int m[16] = { CC_COMBINED, CC_TEX, CC_TEX, CC_PRIM, CC_SHADE, CC_ENV, CC_OTHER, CC_OTHER }; return v < 8 ? m[v] : CC_ZERO; }
+static int cc_rgb_c( int v )
+{
+    static const int m[16] = { CC_COMBINED, CC_TEX, CC_TEX, CC_PRIM, CC_SHADE, CC_ENV, CC_OTHER, CC_OTHER,
+                               CC_TEXA, CC_TEXA, CC_PRIMA, CC_SHADEA, CC_ENVA, CC_OTHER, CC_OTHER, CC_OTHER };
+    return v < 16 ? m[v] : CC_ZERO;
+}
+static int cc_rgb_d( int v ) { static const int m[8] = { CC_COMBINED, CC_TEX, CC_TEX, CC_PRIM, CC_SHADE, CC_ENV, CC_ONE, CC_ZERO }; return m[v & 7]; }
+static int cc_alpha( int v, int isC )
+{
+    static const int ab[8] = { CC_COMBINED, CC_TEXA, CC_TEXA, CC_PRIMA, CC_SHADEA, CC_ENVA, CC_ONE, CC_ZERO };
+    static const int c[8] = { CC_OTHER, CC_TEXA, CC_TEXA, CC_PRIMA, CC_SHADEA, CC_ENVA, CC_OTHER, CC_ZERO };
+    return isC ? c[v & 7] : ab[v & 7];
+}
+
+static int cc_is_tex( int in ) { return in == CC_TEX || in == CC_TEXA; }
+// In the first cycle there is no previous result: read COMBINED as the shade.
+static int cyc1( int in ) { return in == CC_COMBINED ? CC_SHADE : in; }
+
+// The value of a non-texture input for a vertex (rgb; for alpha inputs, all three the same).
+static void cc_value( int in, const struct F3DVertex *v, float out[3] )
+{
+    float a = 1.0f;
+    switch( in )
+    {
+        case CC_ONE: out[0] = out[1] = out[2] = 1.0f; return;
+        case CC_SHADE: out[0] = v->col[0]; out[1] = v->col[1]; out[2] = v->col[2]; return;
+        case CC_PRIM: for( int k = 0; k < 3; ++k ) out[k] = s_f3d.prim[k] / 255.0f; return;
+        case CC_ENV: for( int k = 0; k < 3; ++k ) out[k] = s_f3d.env[k] / 255.0f; return;
+        case CC_PRIMA: a = s_f3d.prim[3] / 255.0f; break;
+        case CC_ENVA: a = s_f3d.env[3] / 255.0f; break;
+        case CC_SHADEA: a = v->alpha; break;
+        default: a = 0.0f; break;
+    }
+    out[0] = out[1] = out[2] = a;
+}
+
+// How a triangle's colour is made: its mode (SM64_MAT_COLOR_*) and the colour
+// per vertex that goes with it.
+static uint32_t f3d_colour( const struct F3DVertex *v[3], float out[3][3] )
+{
+    int a = cyc1( cc_rgb_a( (s_f3d.combine0 >> 20) & 0xF )), b = cyc1( cc_rgb_b( (s_f3d.combine1 >> 28) & 0xF ));
+    int c = cyc1( cc_rgb_c( (s_f3d.combine0 >> 15) & 0x1F )), d = cyc1( cc_rgb_d( (s_f3d.combine1 >> 15) & 0x7 ));
+    int texOn = s_f3d.textureOn && s_f3d.tile;
+    uint32_t mode;
+    int k0 = CC_SHADE; // the colour input that goes with the mode
+    if( !texOn || (!cc_is_tex( a ) && !cc_is_tex( b ) && !cc_is_tex( c ) && !cc_is_tex( d )))
+    {
+        // No texture: evaluate (a - b) * c + d per vertex.
+        for( int i = 0; i < 3; ++i )
+        {
+            float va[3], vb[3], vc[3], vd[3];
+            cc_value( cc_is_tex( a ) ? CC_ONE : a, v[i], va );
+            cc_value( cc_is_tex( b ) ? CC_ZERO : b, v[i], vb );
+            cc_value( cc_is_tex( c ) ? CC_ONE : c, v[i], vc );
+            cc_value( cc_is_tex( d ) ? CC_ZERO : d, v[i], vd );
+            for( int k = 0; k < 3; ++k ) out[i][k] = clamp01( (va[k] - vb[k]) * vc[k] + vd[k] );
+        }
+        return 0u << SM64_MAT_COLOR_SHIFT;
+    }
+    if( a == CC_TEX && b == CC_ZERO && d == CC_ZERO && !cc_is_tex( c )) { mode = 1; k0 = c; }
+    else if( c == CC_TEX && b == CC_ZERO && d == CC_ZERO && !cc_is_tex( a )) { mode = 1; k0 = a; }
+    else if( a == CC_ZERO && b == CC_ZERO && c == CC_ZERO && d == CC_TEX ) { mode = 3; k0 = CC_ONE; }
+    else if( d == CC_TEX && a == b ) { mode = 3; k0 = CC_ONE; }
+    else if( a == CC_TEX && c == CC_TEXA && b == d && !cc_is_tex( b )) { mode = 2; k0 = b; }
+    else if( a == CC_TEX && !cc_is_tex( c )) { mode = 1; k0 = c; }
+    else { mode = 1; k0 = CC_SHADE; }
+
+    // A second cycle that only scales the result: (COMBINED - 0) * X + 0.
+    int twoCycle = ((s_f3d.otherModeH >> 20) & 3) == 1;
+    int a2 = cc_rgb_a( (s_f3d.combine0 >> 5) & 0xF ), b2 = cc_rgb_b( (s_f3d.combine1 >> 24) & 0xF );
+    int c2 = cc_rgb_c( s_f3d.combine0 & 0x1F ), d2 = cc_rgb_d( (s_f3d.combine1 >> 6) & 0x7 );
+    int scale2 = twoCycle && a2 == CC_COMBINED && b2 == CC_ZERO && d2 == CC_ZERO && !cc_is_tex( c2 ) && c2 != CC_COMBINED;
+
+    for( int i = 0; i < 3; ++i )
+    {
+        float kv[3];
+        cc_value( k0 == CC_OTHER ? CC_SHADE : k0, v[i], kv );
+        if( scale2 )
+        {
+            float sv[3];
+            cc_value( c2, v[i], sv );
+            for( int k = 0; k < 3; ++k ) kv[k] *= sv[k];
+        }
+        for( int k = 0; k < 3; ++k ) out[i][k] = clamp01( kv[k] );
+    }
+    return mode << SM64_MAT_COLOR_SHIFT;
+}
+
+// The alpha part of the material: mode, A, and whether it is cut out or
+// dithered.
+static uint32_t f3d_alpha( const struct F3DVertex *v[3] )
+{
+    int a = cc_alpha( (s_f3d.combine0 >> 12) & 0x7, 0 ), b = cc_alpha( (s_f3d.combine1 >> 12) & 0x7, 0 );
+    int c = cc_alpha( (s_f3d.combine0 >> 9) & 0x7, 1 ), d = cc_alpha( (s_f3d.combine1 >> 9) & 0x7, 0 );
+    int texOn = s_f3d.textureOn && s_f3d.tile;
+    uint32_t mode = 0;
+    float k = 1.0f;
+    float tmp[3];
+    if( texOn && a == CC_TEXA && b == CC_ZERO && d == CC_ZERO && !cc_is_tex( c ))
+    {
+        mode = 1;
+        cc_value( c, v[0], tmp );
+        k = tmp[0];
+    }
+    else if( texOn && d == CC_TEXA && a == b ) { mode = 1; k = 1.0f; }
+    else if( texOn && (cc_is_tex( a ) || cc_is_tex( b ) || cc_is_tex( c ) || cc_is_tex( d ))) { mode = 1; k = 1.0f; }
+    else
+    {
+        // A constant (or vertex) alpha: (a - b) * c + d, averaged over the triangle.
+        float sum = 0.0f;
+        for( int i = 0; i < 3; ++i )
+        {
+            float va[3], vb[3], vc[3], vd[3];
+            cc_value( a == CC_COMBINED ? CC_ONE : a, v[i], va );
+            cc_value( b == CC_COMBINED ? CC_ZERO : b, v[i], vb );
+            cc_value( c == CC_OTHER ? CC_ONE : c, v[i], vc );
+            cc_value( d == CC_COMBINED ? CC_ONE : d, v[i], vd );
+            sum += clamp01( (va[0] - vb[0]) * vc[0] + vd[0] );
+        }
+        k = sum / 3.0f;
+        mode = k < 0.999f ? 2 : 0;
+    }
+
+    // Whether alpha matters is the render mode's (and the layer's) decision:
+    // translucent layers and blending see through (dithered here), the alpha
+    // layer and alpha tests cut out, an opaque surface ignores alpha.
+    int alphaCompare = s_f3d.otherModeL & 3;
+    int cvgAlpha = (s_f3d.otherModeL & F3D_RM_CVG_X_ALPHA) != 0;
+    int blend = (s_f3d.otherModeL & F3D_RM_FORCE_BL) != 0;
+    uint32_t flags = 0;
+    if( mode != 0 )
+    {
+        if( s_layer >= 5 || alphaCompare == 3 || (blend && !cvgAlpha && s_layer != 4) ) flags = SM64_MAT_DITHER;
+        else if( s_layer == 4 || alphaCompare == 1 || cvgAlpha ) flags = SM64_MAT_CUTOUT;
+        else mode = 0;
+    }
+    return (mode << SM64_MAT_ALPHA_SHIFT) | ((uint32_t)(clamp01( k ) * 255.0f + 0.5f) << SM64_MAT_A_SHIFT) | flags;
+}
+
+static uint32_t f3d_wrap( uint8_t cm, uint8_t mask )
+{
+    if( (cm & 2) || mask == 0 ) return 2; // clamp
+    if( cm & 1 ) return 1;                 // mirror
+    return 0;
+}
+
+static void f3d_triangle( int i0, int i1, int i2 )
+{
+    if( i0 < 0 || i1 < 0 || i2 < 0 || i0 >= F3D_MAX_VERTICES || i1 >= F3D_MAX_VERTICES || i2 >= F3D_MAX_VERTICES )
+        return;
+    if( !room_for_triangle() )
+        return;
+    const struct F3DVertex *v[3] = { &s_f3d.vtx[i0], &s_f3d.vtx[i1], &s_f3d.vtx[i2] };
+
+    // Unlit (vertex coloured) geometry has no normals: use the face's.
+    Vec3f e1, e2, fn;
+    for( int k = 0; k < 3; ++k )
+    {
+        e1[k] = v[1]->pos[k] - v[0]->pos[k];
+        e2[k] = v[2]->pos[k] - v[0]->pos[k];
+    }
+    vec3f_cross( fn, e1, e2 );
+    float len = sqrtf( fn[0] * fn[0] + fn[1] * fn[1] + fn[2] * fn[2] );
+    if( len > 1e-12f ) { fn[0] /= len; fn[1] /= len; fn[2] /= len; } else { fn[0] = 0; fn[1] = 1; fn[2] = 0; }
+
+    float col[3][3];
+    uint32_t material = f3d_colour( v, col ) | f3d_alpha( v );
+    if( s_f3d.textureOn && s_f3d.tile )
+    {
+        material |= SM64_MAT_TEXTURED | (s_f3d.tile->slot & SM64_MAT_TEXTURE_MASK);
+        material |= f3d_wrap( s_f3d.cms, s_f3d.masks ) << SM64_MAT_WRAP_S_SHIFT;
+        material |= f3d_wrap( s_f3d.cmt, s_f3d.maskt ) << SM64_MAT_WRAP_T_SHIFT;
+    }
+
+    for( int i = 0; i < 3; ++i )
+    {
+        memcpy( s_trianglePtr, v[i]->pos, sizeof( float ) * 3 ); s_trianglePtr += 3;
+        memcpy( s_normalPtr, v[i]->hasNormal ? v[i]->nrm : fn, sizeof( float ) * 3 ); s_normalPtr += 3;
+        memcpy( s_colorPtr, col[i], sizeof( float ) * 3 ); s_colorPtr += 3;
+        if( material & SM64_MAT_TEXTURED )
+        {
+            *s_uvPtr++ = v[i]->uv[0];
+            *s_uvPtr++ = v[i]->uv[1];
+        }
+        else
+        {
+            *s_uvPtr++ = 1.0f;
+            *s_uvPtr++ = 1.0f;
+        }
+    }
+    finish_triangle( material );
+}
+
+static void f3d_set_other_mode( uint32_t *word, uint32_t w0, uint32_t w1 )
+{
+    uint32_t len = (w0 & 0xFF) + 1;
+    int32_t shift = 32 - (int32_t)((w0 >> 8) & 0xFF) - (int32_t)len;
+    if( shift < 0 || len >= 32 ) { *word = w1; return; }
+    uint32_t mask = ((1u << len) - 1u) << shift;
+    *word = (*word & ~mask) | (w1 & mask);
+}
+
+static int s_f3dCommands; // guards against runaway lists
+
+static void process_f3d_display_list( const uintptr_t *cmd, int depth )
+{
+    if( !cmd || depth > 16 ) return;
+    for( ;; )
+    {
+        if( !is_custom_display_list( cmd ) || ++s_f3dCommands > 200000 ) return;
+        uint32_t w0 = (uint32_t)cmd[0];
+        uintptr_t w1 = cmd[1];
+        uint32_t w1l = (uint32_t)w1;
+        switch( w0 >> 24 )
+        {
+            case F3D_VTX:
+            case F3D_VTX_EXT:
+            {
+                int n = (w0 >> 12) & 0xFF;
+                int end = (w0 >> 1) & 0x7F;
+                f3d_load_vertices( (const struct SM64CustomVertex *)w1, n, end - n );
+                break;
+            }
+            case F3D_TRI1:
+                f3d_triangle( ((w0 >> 16) & 0xFF) / 2, ((w0 >> 8) & 0xFF) / 2, (w0 & 0xFF) / 2 );
+                break;
+            case F3D_TRI2:
+            case F3D_TRI2_EXT:
+                f3d_triangle( ((w0 >> 16) & 0xFF) / 2, ((w0 >> 8) & 0xFF) / 2, (w0 & 0xFF) / 2 );
+                f3d_triangle( ((w1l >> 16) & 0xFF) / 2, ((w1l >> 8) & 0xFF) / 2, (w1l & 0xFF) / 2 );
+                break;
+            case F3D_QUAD:
+                f3d_triangle( ((w0 >> 16) & 0xFF) / 2, ((w0 >> 8) & 0xFF) / 2, (w0 & 0xFF) / 2 );
+                f3d_triangle( ((w1l >> 16) & 0xFF) / 2, ((w1l >> 8) & 0xFF) / 2, (w1l & 0xFF) / 2 );
+                break;
+            case F3D_DL:
+                if( ((w0 >> 16) & 1) == 0 )
+                {
+                    if( is_custom_display_list( (const void *)w1 ))
+                        process_f3d_display_list( (const uintptr_t *)w1, depth + 1 );
+                }
+                else
+                {
+                    // branch: continue there, don't come back
+                    if( !is_custom_display_list( (const void *)w1 )) return;
+                    cmd = (const uintptr_t *)w1;
+                    continue;
+                }
+                break;
+            case F3D_ENDDL:
+                return;
+            case F3D_GEOMETRYMODE:
+                s_f3d.geometryMode = (s_f3d.geometryMode & (w0 & 0x00FFFFFFu)) | w1l;
+                break;
+            case F3D_TEXTURE:
+                s_f3d.scaleS = (uint16_t)(w1l >> 16);
+                s_f3d.scaleT = (uint16_t)w1l;
+                s_f3d.textureOn = ((w0 >> 1) & 0x7F) != 0;
+                break;
+            case F3D_MOVEMEM:
+                if( (w0 & 0xFF) == F3D_MV_LIGHT && w1 )
+                {
+                    int idx = (int)(((w0 >> 8) & 0xFF) * 8) / 24 - 2;
+                    if( idx >= 0 && idx < F3D_MAX_LIGHTS ) memcpy( s_f3d.lights[idx], (const void *)w1, 3 );
+                }
+                break;
+            case F3D_COPYMEM:
+                if( (w0 & 0xFF) == F3D_MV_LIGHT )
+                {
+                    int dst = (int)(((w0 >> 8) & 0xFF) * 8) / 24 - 2;
+                    int src = (int)(((w0 >> 16) & 0xFF) * 8) / 24 - 2;
+                    if( dst >= 0 && src >= 0 && dst < F3D_MAX_LIGHTS && src < F3D_MAX_LIGHTS )
+                        memcpy( s_f3d.lights[dst], s_f3d.lights[src], 3 );
+                }
+                break;
+            case F3D_MOVEWORD:
+                if( ((w0 >> 16) & 0xFF) == F3D_MW_LIGHTCOL )
+                {
+                    int idx = (int)(w0 & 0xFFFF) / 24;
+                    if( idx >= 0 && idx < F3D_MAX_LIGHTS )
+                    {
+                        s_f3d.lights[idx][0] = (uint8_t)(w1l >> 24);
+                        s_f3d.lights[idx][1] = (uint8_t)(w1l >> 16);
+                        s_f3d.lights[idx][2] = (uint8_t)(w1l >> 8);
+                    }
+                }
+                break;
+            case F3D_PPARTTOCOLOR:
+            {
+                int idx = (int)w1l - 1; // light index
+                if( idx >= 0 && idx < F3D_MAX_LIGHTS )
+                {
+                    uint8_t *target = ((w0 >> 16) & 0xFF) == 0 ? s_f3d.prim : s_f3d.env;
+                    memcpy( target, s_f3d.lights[idx], 3 );
+                }
+                break;
+            }
+            case F3D_SETOTHERMODE_L:
+                f3d_set_other_mode( &s_f3d.otherModeL, w0, w1l );
+                break;
+            case F3D_SETOTHERMODE_H:
+                f3d_set_other_mode( &s_f3d.otherModeH, w0, w1l );
+                break;
+            case F3D_SETTIMG:
+                s_f3d.image = (const struct SM64CustomTexture *)w1;
+                break;
+            case F3D_LOADBLOCK:
+            case F3D_LOADTILE:
+                s_f3d.tile = s_f3d.image;
+                break;
+            case F3D_SETTILE:
+                if( ((w1l >> 24) & 7) == 0 ) // the render tile
+                {
+                    s_f3d.cmt = (w1l >> 18) & 3;
+                    s_f3d.maskt = (w1l >> 14) & 0xF;
+                    s_f3d.cms = (w1l >> 8) & 3;
+                    s_f3d.masks = (w1l >> 4) & 0xF;
+                }
+                break;
+            case F3D_SETTILESIZE:
+                if( ((w1l >> 24) & 7) == 0 )
+                {
+                    s_f3d.uls = (w0 >> 12) & 0xFFF;
+                    s_f3d.ult = w0 & 0xFFF;
+                }
+                break;
+            case F3D_SETPRIMCOLOR:
+                s_f3d.prim[0] = (uint8_t)(w1l >> 24); s_f3d.prim[1] = (uint8_t)(w1l >> 16);
+                s_f3d.prim[2] = (uint8_t)(w1l >> 8);  s_f3d.prim[3] = (uint8_t)w1l;
+                break;
+            case F3D_SETENVCOLOR:
+                s_f3d.env[0] = (uint8_t)(w1l >> 24); s_f3d.env[1] = (uint8_t)(w1l >> 16);
+                s_f3d.env[2] = (uint8_t)(w1l >> 8);  s_f3d.env[3] = (uint8_t)w1l;
+                break;
+            case F3D_SETENVRGB:
+                s_f3d.env[0] = (uint8_t)(w1l >> 24); s_f3d.env[1] = (uint8_t)(w1l >> 16);
+                s_f3d.env[2] = (uint8_t)(w1l >> 8);
+                break;
+            case F3D_SETCOMBINE:
+                s_f3d.combine0 = w0 & 0x00FFFFFFu;
+                s_f3d.combine1 = w1l;
+                break;
+            default:
+                break;
+        }
+        cmd += 2;
+    }
+}
