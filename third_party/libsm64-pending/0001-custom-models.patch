+    translation[1] = cur_geo_cmd_s16(0x06);
+    translation[2] = cur_geo_cmd_s16(0x08);
+    graphNode = init_graph_node_animated_part(gGraphNodePool, NULL, params & 0x0F, cur_geo_cmd_ptr(dlOffset),
+                                              translation);
+    register_scene_graph_node(&graphNode->node);
+    gGeoLayoutCommand += (dlOffset + 4) << CMD_SIZE_SHIFT;
+}
