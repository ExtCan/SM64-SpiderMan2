+static void geo_layout_cmd_coop_bone(void) {
+    struct GraphNodeAnimatedPart *graphNode;
+    s32 params = cur_geo_cmd_u8(0x01);
+    s32 dlOffset = (params & 0x80) ? 0x1C : 0x10;
+    Vec3s translation;
